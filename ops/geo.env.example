# GEO 营销平台（Rust 版）运维配置模板
# 用法：复制为 ops/geo.env（勿提交）后按需修改；geo-ctl.sh 会自动 source 它，
#       install.sh 也可 `source ops/geo.env` 后以裸参数执行。

# ---- 服务 ----
GEO_SERVICE=geo-rust                 # systemd 服务名
GEO_DIR=/opt/geo-rust                # 安装目录（二进制与源码所在）
GEO_PORT=3438                        # 监听端口

# ---- 数据 ----
GEO_DB=/opt/geo/platform/data/geo.db # SQLite 数据库（WAL 模式）
GEO_UPLOADS=/opt/geo-rust/data/uploads # 封面/素材上传目录

# ---- 备份 ----
GEO_BACKUP_DIR=/opt/geo-backup       # 备份输出目录
GEO_KEEP=14                          # 备份保留份数

# ---- 部署机（make deploy / scripts 用，勿提交真实值）----
# DEPLOY_HOST=root@120.x.x.x
# DEPLOY_KEY=~/.ssh/your_key
# DEPLOY_DIR=/opt/geo-rust

# ---- install.sh 写入 systemd 的环境变量（默认值）----
# SEED_DEMO=0            # 生产设 0：不写演示种子
# DISABLE_REGISTER=1     # 生产设 1：关闭自助注册，管理员建号
# PUBLISH_MODE=manual    # manual=人工发布+回填（默认）；mock=演示自动结算
