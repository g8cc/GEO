# GEO 平台 Nginx 反代 + HTTPS 模板（域名备案通过后启用）
# 步骤：1) 域名解析到服务器 2) certbot 获取证书 3) 替换 server_name 与证书路径
#       4) cp 到 /etc/nginx/conf.d/geo.conf && nginx -t && systemctl reload nginx
#       5) systemd unit 加 SESSION_SECURE=1，平台「系统配置」TRUST_PROXY=1
server {
    listen 443 ssl http2;
    server_name geo.example.com;                # ← 替换为你的域名
    ssl_certificate     /etc/letsencrypt/live/geo.example.com/fullchain.pem;   # ← 替换
    ssl_certificate_key /etc/letsencrypt/live/geo.example.com/privkey.pem;     # ← 替换
    client_max_body_size 25m;
    location / {
        proxy_pass http://127.0.0.1:3438;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
server { listen 80; server_name geo.example.com; return 301 https://$host$request_uri; }
